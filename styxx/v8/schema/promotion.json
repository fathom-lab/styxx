{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:styxx:v8:schema:promotion",
  "title": "styxx/8.0 promotion cert (spec section 7.2)",
  "type": "object",
  "properties": {
    "type": { "const": "promotion" },
    "subject": { "type": "object" },
    "recipe": { "type": "object" },
    "body": {
      "type": "object",
      "required": ["instrument", "version", "code_sha256", "scope", "claim"],
      "properties": {
        "instrument": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "code_sha256": { "$ref": "urn:styxx:v8:schema:common#/$defs/hex64" },
        "scope": {
          "type": "object",
          "required": ["model_family", "task_family"],
          "properties": {
            "model_family": { "type": "string", "minLength": 1 },
            "task_family": { "type": "string", "minLength": 1 }
          }
        },
        "claim": { "type": "string" }
      }
    }
  }
}
