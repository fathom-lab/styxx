{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:styxx:v8:schema:common",
  "title": "styxx/8.0 shared definitions (Appendix A.1 encodings)",
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cert_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
    },
    "rfc3339_z": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "nonneg_int": {
      "type": "integer",
      "minimum": 0
    },
    "pos_int": {
      "type": "integer",
      "minimum": 1
    },
    "int_array": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "number_array": {
      "type": "array",
      "items": { "type": "number" }
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
