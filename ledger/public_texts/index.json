 "rewrite_reason": null,
 "rule": {
  "allow_list": "a text is published only for a ledger line with kind send, action send, dest_class public, a sent_sha256, and a dest_hash in config.json's group_hashes or equal to its anchor_channel_hash; never the canary chat, never the operator's dm, never a destination absent from config.json. the allow-list is the gate's own config, which names the public group and the anchor channel as the destinations whose texts may be published; the canary chat is where the lab's canary probes go (planted test sentences that measure the gate), a test fixture and not a public audience, so its texts stay hash-only; a chat the operator has not named in the config is not presumed public, so its texts stay hash-only until it is named",
  "allow_list_roles": [
   "group",
   "anchor_channel"
  ],
