    value: "10.5281/zenodo.19758618"
    description: "styxx software (concept DOI — resolves to the latest version; 7.50.0 is 10.5281/zenodo.23594959)"

# Preferred citation: the position paper. Its central claims are bounded or falsified by a
# scope erratum (2026-06-21) in the repo copy, papers/every-mind-leaves-vitals.md; whether it
# stays the preferred citation is defect D2 in zenodo/MANIFEST.json, the operator's call.
preferred-citation:
  type: article
  title: "Every Mind Leaves Vitals: A Position on Cognometric Observability"
  authors:
