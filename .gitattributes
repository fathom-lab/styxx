# Hash-pinned calibration data: styxx/vitals.py pins these files' sha256
# (EXPECTED_CENTROIDS_SHA256). They MUST be byte-identical on every platform,
# so never apply EOL normalization — a Windows CRLF checkout would change the
# bytes and break the hash (which is exactly what happened: the pin was a
# CRLF-rendered hash, so the LF Linux CI checkout failed to verify).
styxx/centroids/*.json -text

# Sworn documents are BYTE-PINNED: the sidecar records span offsets into the exact
# bytes of the document, and render(sidecar) is asserted equal to the document's bytes.
# EOL translation changes those bytes and every offset after the first newline, so a
# Windows CRLF checkout breaks the round-trip that is the format's whole guarantee.
# Same failure class as styxx/centroids above, in the mirror direction.
# tests/test_sworn_eol.py fails if a sworn artifact is ever added without an entry here.
papers/sworn/** -text
papers/closed-model-frontier/DECLARATION_h_mapping_2026_09_01.md -text
papers/closed-model-frontier/DECLARATION_h_mapping_2026_09_01.sworn.json -text
papers/closed-model-frontier/DECLARATION_h_mapping_2026_09_01.sworn-receipt.json -text

# h_mapping.json is sha256-pinned by h_mapping_census_result.json; the census hashed
# its LF bytes, so a CRLF checkout makes the pin fail on Windows only.
papers/closed-model-frontier/h_mapping.json -text
papers/closed-model-frontier/h_mapping_census_result.json -text

