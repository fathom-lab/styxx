     raise TypeError(f"not JCS-serializable: {type(obj).__name__}")
 
 
+def jcs(obj: Any) -> str:
+    """Public RFC 8785 canonical serialization (same domain limits as _jcs).
+
+    Exposed for consumers that hash styxx artifacts outside this module — the
